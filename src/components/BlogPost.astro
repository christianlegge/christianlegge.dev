---
import { type CollectionEntry, render } from "astro:content";
import Tag from "./Tag.astro";
import { titleToSlug } from "../util/blogTitle";

export interface Props {
	post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<article class="blog-post md:text-lg">
	<h1>
		<a
			href={`/blog/${titleToSlug(post.data.title)}`}
			class="link"
			style={{ textDecorationLine: "none" }}>{post.data.title}</a
		>
	</h1>
	<p class="text-sm opacity-75" id="post-date">
		{new Date(post.id).toUTCString().slice(0, 16)}
	</p>
	<Content />
	<ul class="mt-8 flex flex-wrap gap-1">
		{
			post.data.tags &&
				post.data.tags.map((tag) => (
					<li style={{ listStyleType: "none" }}>
						<Tag>{tag}</Tag>
					</li>
				))
		}
	</ul>
</article>
<style>
	article {
		font-family: var(--font-newsreader), serif;
	}
</style>
<script>
	function containsImage(el: HTMLElement) {
		return el.getElementsByTagName("img").length > 0;
	}
	const post = document.getElementsByClassName("blog-post");
	if (post[0] && post[0].children) {
		const textPs = Array.from(post[0].children).filter(
			(el) => (el as HTMLElement).innerText !== "" && el.tagName === "P"
		);
		let largeNext = true;
		for (const postEl of Array.from(post[0].children)) {
			if (
				postEl.id !== "post-date" &&
				postEl.id !== "first-letter-exclude" &&
				!containsImage(postEl) &&
				largeNext &&
				(postEl as HTMLElement).innerText !== "" &&
				postEl.tagName === "P"
			) {
				postEl.classList.toggle("large-first-letter");
				largeNext = false;
			} else if (postEl.tagName === "HR") {
				largeNext = true;
			}
		}
		const svg = document.createElement("img");
		svg.src = "/images/cl_dark.svg";
		svg.alt = "SVG CL logo";
		svg.style = "height:1.8rem;display:inline;margin-left:0.5rem";
		const lastP = textPs[textPs.length - 1];
		lastP.append(svg);
	}
</script>
