---
import type { GetStaticPaths, GetStaticPathsOptions } from "astro";
import BlogPost from "../../components/BlogPost.astro";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { getCollection } from "astro:content";
import { titleToSlug } from "../../util/blogTitle";

export const getStaticPaths = (async ({ paginate }: GetStaticPathsOptions) => {
	const posts = await getCollection("blog");
	posts.sort((a, b) => b.id.localeCompare(a.id));

	return paginate(posts, {
		pageSize: 5,
	});
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BlogLayout title="blog">
	<h1>My blog</h1>
	<div class="mt-4 space-y-8">
		{
			page.currentPage > 1 && (
				<a
					href={`/blog${page.currentPage === 2 ? "" : `/${page.currentPage - 1}`}`}
					class="mb-4 block text-lg"
				>
					Newer posts
				</a>
			)
		}
		{
			page.data.map((post) => (
				<>
					<div class="post-preview relative max-h-96 overflow-clip">
						<BlogPost post={post} />
					</div>
					<a
						href={`/blog/${titleToSlug(post.data.title)}`}
						class="my-2 block w-full rounded-lg bg-linear-to-b from-slate-300 to-slate-400 py-2 text-center text-black! not-italic! no-underline!"
					>
						Full post
					</a>
					<hr />
				</>
			))
		}
		{
			page.currentPage < page.lastPage && (
				<a href={`/blog/${page.currentPage + 1}`} class="text-lg">
					Older posts
				</a>
			)
		}
	</div>
</BlogLayout>
<style>
	.post-preview {
		mask-image: linear-gradient(black, black 50%, transparent);
	}
</style>
